<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <AssemblyName>QuickClean</AssemblyName>
    <RootNamespace>QuickClean</RootNamespace>
    <Version>1.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <Product>QuickClean 快捷安全清理工具</Product>
    <Description>Windows 快捷安全清理工具：硬盘清理 + 内存优化，单文件自包含发布，无需安装运行时。</Description>
    <Copyright>QuickClean</Copyright>

    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- ===== 单文件自包含发布配置 ===== -->
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- 注意：WinForms 不支持剪裁（NETSDK1175），故不启用 PublishTrimmed -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- 原生库直接从 bundle 加载，不落地到 %TEMP%\.net：启动更快，且不依赖可写的临时目录 -->
    <IncludeNativeLibrariesForSelfExtract>false</IncludeNativeLibrariesForSelfExtract>

    <!-- ===== 体积优化 ===== -->
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <SatelliteResourceLanguages>zh-Hans</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
